# انسخ الملف ده باسم .env وحط مفتاحك
# احصل على المفتاح من: https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-...

# الموديل الافتراضي للمشاريع الجديدة
DEFAULT_MODEL=claude-sonnet-5

# الموديل المستخدم للمشاريع القانونية الحرجة
LEGAL_MODEL=claude-opus-5

# أقصى حجم ملف مرفوع (ميجابايت)
MAX_UPLOAD_MB=200

# --- محرّك DeepL (اختياري) ---
# بديل لـ Claude تختاره لكل مشروع. أسرع وثابت النتيجة، ومجاني حتى
# 500 ألف حرف شهريًا. احصل على مفتاح من: https://www.deepl.com/pro-api
# المفتاح المنتهي بـ ":fx" معناه باقة مجانية.
DEEPL_API_KEY=

# quality_optimized | prefer_quality_optimized | latency_optimized
DEEPL_MODEL_TYPE=quality_optimized

# سعر باقتك بالدولار لكل مليون حرف — عدّله حسب اشتراكك الفعلي
DEEPL_USD_PER_MILLION_CHARS=25.0
