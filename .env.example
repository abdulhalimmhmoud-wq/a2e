# انسخ الملف ده باسم .env وحط مفتاحك
# احصل على المفتاح من: https://console.anthropic.com/settings/keys

ANTHROPIC_API_KEY=sk-ant-...

# الموديل الافتراضي للمشاريع الجديدة
DEFAULT_MODEL=claude-sonnet-5

# الموديل المستخدم للمشاريع القانونية الحرجة
LEGAL_MODEL=claude-opus-5

# أقصى حجم ملف مرفوع (ميجابايت)
MAX_UPLOAD_MB=200

# --- محرّك DeepL (اختياري) ---
# بديل لـ Claude تختاره لكل مشروع. أسرع وثابت النتيجة، ومجاني حتى
# 500 ألف حرف شهريًا. احصل على مفتاح من: https://www.deepl.com/pro-api
# المفتاح المنتهي بـ ":fx" معناه باقة مجانية.
DEEPL_API_KEY=

# quality_optimized | prefer_quality_optimized | latency_optimized
DEEPL_MODEL_TYPE=quality_optimized

# سعر باقتك بالدولار لكل مليون حرف — عدّله حسب اشتراكك الفعلي
DEEPL_USD_PER_MILLION_CHARS=25.0

# --- المصادر المعتمدة للنص المقدّس ---
# الآيات بتتجاب من quran.com (مفتوح، مش محتاج مفتاح) والأحاديث من
# sunnah.com. الأداة مابتخزّنش أي ترجمة جوّاها — بتجيبها وقت الطلب
# وبتسجّل الإسناد مع المقطع.
#
# معرّف الترجمة المستخدَمة للآيات على quran.com:
#   20 = Saheeh International   19 = Pickthall   22 = Yusuf Ali
#   85 = Abdel Haleem           84 = T. Usmani
# شوف القائمة كاملة من: /api/sources/translations
#
# الاختيار ده مالوش أثر على الجودة بس: الترجمات الحديثة محمية بحقوق
# نشر، والقديمة وضعها بيختلف من ولاية قضائية للتانية. لو هتنشر
# المستند، اتأكد إن الترجمة اللي اخترتها مسموح بيها عندك.
QURAN_TRANSLATION_ID=20

# sunnah.com بيديّ مفتاح الواجهة البرمجية بالطلب. من غيره الأداة
# بترجّع رابط بحث جاهز عشان تنقل الترجمة المعتمدة بنفسك.
SUNNAH_API_KEY=
